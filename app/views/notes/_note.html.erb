<%= turbo_frame_tag dom_id(note) do %>
  <div class="note-item">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <span class="timestamp" 
            data-action="click->video-notes#seekTo" 
            data-video-notes-time-param="<%= note.timestamp %>"
            role="button">
        <i class="bi bi-play-circle-fill"></i>
        <%= note.formatted_timestamp %>
      </span>
      <%= button_to video_note_path(@video, note), 
          method: :delete,
          data: { 
            turbo_method: :delete,
            turbo_confirm: "Delete this note?",
            turbo_frame: "notes_list"
          },
          class: "btn btn-link btn-sm text-danger p-0",
          style: "text-decoration: none;" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
    <p class="mb-1"><%= note.content %></p>
    <small class="text-muted">
      <%= time_ago_in_words(note.created_at) %> ago
    </small>
  </div>
<% end %>
