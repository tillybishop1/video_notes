<div class="container">
  <div class="page-header">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h1>Video Library</h1>
        <p class="lead text-muted mb-0">Learn from expert-led courses and take notes as you go</p>
      </div>
    </div>
  </div>

  <% if @videos.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
      <% @videos.each do |video| %>
        <div class="col">
          <%= link_to video_path(video), class: "text-decoration-none" do %>
            <div class="card video-card h-100 shadow-sm">
              <div class="card-img-wrapper">
                <div class="card-img-overlay">
                  <i class="bi bi-play-circle play-icon"></i>
                </div>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= video.title %></h5>
                <% if video.description.present? %>
                  <p class="card-text"><%= truncate(video.description, length: 100) %></p>
                <% end %>
                <% if video.duration.present? %>
                  <p class="small text-muted mb-0">
                    <i class="bi bi-clock"></i> <%= distance_of_time_in_words(video.duration) %>
                  </p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="row justify-content-center">
      <div class="col-md-8 text-center py-5">
        <i class="bi bi-collection-play" style="font-size: 4rem; color: #ccc;"></i>
        <h3 class="mt-3">No videos available yet</h3>
        <p class="text-muted">Videos will appear here once they are added to the library.</p>
      </div>
    </div>
  <% end %>
</div>
